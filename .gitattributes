# Pliki tekstowe: normalizacja w repozytorium i LF w katalogu roboczym.
* text=auto eol=lf

# Skrypty Windows: CRLF w katalogu roboczym, LF w indeksie Gita.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Kod, dokumentacja i SVG pozostają tekstem.
*.sh text eol=lf
*.php text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.svg text eol=lf diff

# Zasoby binarne: bez konwersji końców linii i tekstowych diffów.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.webm binary
